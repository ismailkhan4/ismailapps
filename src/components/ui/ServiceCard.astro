---
/** A service as a card: used by the homepage rail and the services overview grid. */
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
  index: number;
}
const { service, index } = Astro.props;
const d = service.data;
---

<a href={`/services/${service.id}`} class:list={['card-link', d.featured && 'is-featured', d.tag && 'is-signature']}>
  <span class="card-top">
    <span class="t-mono card-n">{String(index + 1).padStart(2, '0')}</span>
    {d.tag && <span class="t-mono card-tag">{d.tag}</span>}
  </span>
  <span class="card-title">{d.title}</span>
  <span class="card-line">{d.oneLiner}</span>
  <span class="card-for">
    <span class="t-mono card-for-label">for</span>
    {d.forWho[0]}
  </span>
  <span class="card-more">Details <span aria-hidden="true">→</span></span>
</a>

<style>
  .card-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    min-height: 25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      transform 500ms cubic-bezier(0.2, 0.7, 0, 1),
      box-shadow 500ms cubic-bezier(0.2, 0.7, 0, 1),
      border-color 300ms;
  }
  .card-link:hover,
  .card-link:focus-visible {
    transform: translateY(-6px);
    border-color: var(--color-ink);
    box-shadow: 0 24px 50px -30px rgb(23 21 15 / 0.45);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-n {
    color: var(--color-ink-muted);
  }
  .card-tag {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-signal-ink);
    font-size: 0.75rem;
  }
  .card-title {
    margin-top: auto;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .is-featured .card-title {
    font-size: var(--step-3);
  }
  .card-line {
    color: var(--color-ink-muted);
    font-size: 1rem;
    line-height: 1.5;
  }
  .card-for {
    padding-top: 1rem;
    border-top: 1px dashed var(--color-rule);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .card-for-label {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
  }
  .card-more {
    font-weight: 600;
  }
  .card-more span {
    display: inline-block;
    transition: transform 300ms;
  }
  .card-link:hover .card-more span {
    transform: translateX(4px);
  }

  /* The signature service: orange card (white text 5.9:1, tint 4.8:1). */
  .is-signature {
    background: var(--color-signal-ink);
    border-color: var(--color-signal-ink);
    color: var(--color-white);
  }
  .is-signature .card-n,
  .is-signature .card-line,
  .is-signature .card-for-label {
    color: var(--color-signal-tint);
  }
  .is-signature .card-for {
    border-color: var(--color-signal-tint);
  }
  .is-signature:focus-visible {
    outline-color: var(--color-ink);
  }

  @media (width >= 56.25rem) {
    .card-link {
      min-height: 28rem;
      padding: 2rem;
    }
  }
</style>
