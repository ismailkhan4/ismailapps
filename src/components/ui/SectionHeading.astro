---
/** Mono label + section title (+ optional intro slot). The title id labels the section. */
interface Props {
  id: string;
  label: string;
  title: string;
  level?: 'h1' | 'h2';
}
const { id, label, title, level = 'h2' } = Astro.props;
const Heading = level;
---

<header class="section-heading">
  <p class="t-label">{label}</p>
  <Heading id={id} class={level === 'h1' ? 't-h1' : 't-h2'}>{title}</Heading>
  {Astro.slots.has('default') && <div class="t-lead section-intro"><slot /></div>}
</header>

<style>
  .section-heading :global(h1),
  .section-heading :global(h2) {
    margin: 0.6rem 0 0;
    max-width: 20ch;
  }
  .section-intro {
    margin-top: 1.25rem;
    max-width: 44ch;
  }
  .section-intro :global(p) {
    margin: 0;
  }
</style>
