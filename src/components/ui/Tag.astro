---
/**
 * Version / status notation — the brand's signature motif.
 *   <Tag>staging · early access</Tag>
 *   <Tag tone="live">Live</Tag>            → green, reserved for "Live" only
 *   <Tag tone="signal">fixed quote</Tag>   → live-green keyline
 *   <Tag tone="dev">In development</Tag>
 *   <Tag label="you own">repo · hosting · accounts</Tag>
 */
interface Props {
  tone?: 'default' | 'quiet' | 'live' | 'signal' | 'dev' | 'beta';
  /** Optional muted key shown before the value, e.g. "you own:". */
  label?: string;
}
const { tone = 'default', label } = Astro.props;
const hasDot = tone === 'live' || tone === 'signal' || tone === 'dev' || tone === 'beta';
---

<span
  class:list={[
    'tag',
    tone === 'quiet' && 'tag-quiet',
    tone === 'live' && 'tag-live',
    (tone === 'signal' || tone === 'beta') && 'tag-signal',
    tone === 'dev' && 'tag-dev',
  ]}
>
  {hasDot && <span class="tag-dot" aria-hidden="true" />}
  {label && <span class="tag-key">{label}:</span>}
  <span><slot /></span>
</span>
