---
/**
 * Closing call to action on every page except the homepage, which places
 * GoLive itself. One closing moment site-wide: the green "live" panel.
 * With a pre-filled `href` (service pages) it shows a single button;
 * otherwise the visitor answers the headline by choosing their stage.
 */
import GoLive from '../home/GoLive.astro';

interface Props {
  sub?: string;
  href?: string;
  /** Analytics location for the CTA click. */
  location: string;
}
const {
  sub = "Idea, prototype or live product. We'll tell you honestly what it needs next.",
  href,
  location,
} = Astro.props;
---

<GoLive location={location} sub={sub} href={href} wide={false} />
