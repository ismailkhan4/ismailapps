---
/** Closing call to action: oversized line and a magnetic button. */
import Button from '../ui/Button.astro';

interface Props {
  sub?: string;
  href?: string;
  /** Analytics location for the CTA click. */
  location: string;
}
const {
  sub = "Idea, prototype or live product. We'll tell you honestly what it needs next.",
  href = '/contact',
  location,
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container-site">
    <p class="t-label">next step</p>
    <h2 id="cta-title" class="cta-title">
      Tell us where your product is today.
    </h2>
    <div class="cta-row">
      <p class="t-lead cta-sub">{sub}</p>
      <span data-magnetic class="cta-magnet">
        <Button href={href} event="cta_click" location={location} arrow>Start a project</Button>
      </span>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-rule);
  }
  .cta-title {
    margin: 1rem 0 0;
    font-size: clamp(3rem, 1.6rem + 6.4vw, 8rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 13ch;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--color-ink);
  }
  .cta-sub {
    margin: 0;
    max-width: 40ch;
  }
  .cta-magnet {
    display: inline-block;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .cta-magnet :global(.btn) {
    min-height: 3.75rem;
    padding-inline: 2rem;
    font-size: 1.125rem;
  }
</style>
