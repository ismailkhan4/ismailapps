---
/**
 * Hero visual: our own product, Hamstalk, as real screenshots of the live site
 * on desktop and phone. Both frames rise in on load; on hover devices they tilt
 * toward the cursor, the phone moving more for depth (motion.ts).
 */
import { Image } from 'astro:assets';
import { getProducts } from '../../lib/content';

const [product] = await getProducts();
const host = product?.data.url ? new URL(product.data.url).hostname : '';
---

{
  product && product.data.cover && product.data.mobileCover && (
    <figure class="showcase" data-tilt="6">
      <div class="stage">
        <div class="desk">
          <div class="desk-bar" aria-hidden="true">
            <span class="dots">
              <i />
              <i />
              <i />
            </span>
            <span class="t-mono url">{host}</span>
          </div>
          <div class="desk-shot">
            <Image
              src={product.data.cover}
              alt={`The ${product.data.name} website on desktop`}
              widths={[640, 1100]}
              sizes="(min-width: 900px) 38vw, 88vw"
              loading="eager"
            />
          </div>
        </div>
        <div class="phone">
          <div class="phone-shot">
            <Image
              src={product.data.mobileCover}
              alt={`${product.data.name} on a phone`}
              widths={[240, 480]}
              sizes="11rem"
              loading="eager"
            />
          </div>
        </div>
      </div>
      <figcaption class="caption">
        <span class="tag tag-live">
          <span class="tag-dot" aria-hidden="true" />
          {product.data.statusNote ? `Live · ${product.data.statusNote}` : 'Live'}
        </span>
        <span class="caption-text">
          <a href={`/products/${product.id}`} class="caption-name">
            {product.data.name}
          </a>
          , our own product
        </span>
        {product.data.url && (
          <a
            href={product.data.url}
            class="caption-visit t-mono"
            rel="noopener"
            data-umami-event={`outbound_${product.id}`}
            data-umami-event-location="hero"
          >
            Visit {host} <span aria-hidden="true">↗</span>
            <span class="sr-only">(external site)</span>
          </a>
        )}
      </figcaption>
    </figure>
  )
}

<style>
  .showcase {
    --rx: 0deg;
    --ry: 0deg;
    margin: 0;
  }
  .stage {
    position: relative;
    padding: 0 0 2.5rem 2.5rem;
    perspective: 1400px;
    transform-style: preserve-3d;
  }
  .desk,
  .phone {
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .desk {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 80px -45px rgb(23 21 15 / 0.45);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
  }
  .desk-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--color-rule);
  }
  .url {
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .desk-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .desk-shot :global(img),
  .phone-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .phone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(7.5rem, 30%, 11rem);
    padding: 0.4rem;
    background: var(--color-ink);
    border-radius: 1.6rem;
    box-shadow: 0 30px 50px -20px rgb(23 21 15 / 0.55);
    /* Moves further than the desktop frame: reads as depth. */
    transform: translate3d(calc(var(--ry) * -2.2), calc(var(--rx) * 2.2), 60px) rotate(-4deg);
  }
  .phone-shot {
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 1.25rem;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }
  .caption-name {
    font-weight: 600;
    text-decoration: none;
  }
  .caption-name:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .caption-visit {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  /* Entrance: desktop rises first, then the phone. */
  @media (prefers-reduced-motion: no-preference) {
    .desk {
      animation: rise 1100ms cubic-bezier(0.2, 0.7, 0, 1) 350ms backwards;
    }
    .phone {
      animation: rise-phone 1100ms cubic-bezier(0.2, 0.7, 0, 1) 650ms backwards;
    }
    .caption {
      animation: fade 700ms var(--ease-precise) 1100ms both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(2.5rem) rotateX(8deg);
    }
  }
  @keyframes rise-phone {
    from {
      opacity: 0;
      transform: translate3d(-1rem, 3rem, 60px) rotate(-10deg);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
