---
import VersionTag from '../ui/VersionTag.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import HeroProduct from './HeroProduct.astro';

const before = 'SaaS and AI products, built to'.split(' ');
const notes = [
  { n: '01', text: 'Scoped first, then a fixed quote' },
  { n: '02', text: 'A staging link early in the build' },
  { n: '03', text: 'You own the repo, hosting and accounts' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-site grid-site hero-grid">
    <div class="hero-copy">
      <VersionTag />
      <h1 id="hero-title" class="t-display hero-title">
        {
          before.map((w, i) => (
            <>
              <span class="mask-word" style={`--i:${i}`}>
                <span>{w}</span>
              </span>{' '}
            </>
          ))
        }
        <span class="mask-word" style={`--i:${before.length}`}><span>hold</span></span>{' '}<span
          class="mask-word"
          style={`--i:${before.length + 1}`}><span>up</span></span
        >{' '}
        {
          ['after', 'the', 'demo.'].map((w, i) => (
            <>
              {i > 0 && ' '}
              <span class="mask-word" style={`--i:${before.length + 2 + i}`}>
                <span>{w}</span>
              </span>
            </>
          ))
        }
      </h1>
      <p class="t-lead hero-sub">
        IsmailApps is a software product studio. We design, build and maintain SaaS and AI products for founders, and we
        run our own.
      </p>
      <div class="hero-actions">
        <span data-magnetic class="magnetic">
          <Button href="/contact" event="cta_click" location="hero" arrow>Start a project</Button>
        </span>
        <TextLink href="/work">See our work</TextLink>
      </div>
    </div>
    <div class="hero-visual">
      <HeroProduct />
    </div>
  </div>

  <div class="container-site">
    <ol class="hero-notes">
      {
        notes.map((note) => (
          <li>
            <span class="t-mono hero-note-n">{note.n}</span>
            <span>{note.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 4.5rem);
  }
  .hero-grid {
    row-gap: 4rem;
    align-items: center;
  }
  .hero-copy,
  .hero-visual {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .hero-title {
    margin: 1.75rem 0 0;
    max-width: 14ch;
  }
  .hero-sub {
    margin: 1.75rem 0 0;
    max-width: 40ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
  }
  .magnetic {
    display: inline-block;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .hero-notes {
    display: grid;
    gap: 0;
    list-style: none;
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .hero-notes li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-weight: 500;
  }
  .hero-note-n {
    color: var(--color-signal-ink);
  }
  @media (width >= 56.25rem) {
    .hero-copy {
      grid-column: 1 / span 7;
    }
    .hero-visual {
      grid-column: 8 / span 5;
      padding-top: 2rem;
    }
    .hero-notes {
      grid-template-columns: repeat(3, 1fr);
    }
    .hero-notes li {
      padding-right: 1.5rem;
      border-bottom: 0;
    }
    .hero-notes li + li {
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-rule);
    }
  }
</style>
