---
import VersionTag from '../ui/VersionTag.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';

/**
 * Homepage hero. Instead of a screenshot or an invented dashboard, the visual
 * is a "release sheet": the approved engagement facts set as engineering notes.
 * Every line maps to an approved claim (spec §1.5) — do not add unapproved ones.
 */
const notes = [
  { key: 'scope', value: 'Agreed in a scoping sprint' },
  { key: 'price', value: 'Fixed quote before the build' },
  { key: 'staging', value: 'Your link, early in the build' },
  { key: 'you own', value: 'Repo · hosting · accounts' },
  { key: 'lead', value: 'One person, scoping to care' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-site grid-site hero-grid">
    <div class="hero-copy">
      <VersionTag />
      <h1 id="hero-title" class="t-display hero-title">
        SaaS and AI products, built to hold up after the&nbsp;demo.
      </h1>
      <p class="t-lead hero-sub measure">
        IsmailApps is a software product studio. We design, build and maintain SaaS and AI products for founders, and we
        run our own.
      </p>
      <div class="hero-actions">
        <Button href="/contact" event="cta_click" location="hero">Start a project</Button>
        <TextLink href="/work">See our work</TextLink>
      </div>
    </div>

    <aside class="hero-sheet" aria-label="How every project runs">
      <p class="sheet-head t-mono">
        <span>release notes</span><span>v1.0</span>
      </p>
      <dl class="sheet-list">
        {
          notes.map((n) => (
            <div class="sheet-row">
              <dt class="t-mono">{n.key}</dt>
              <dd>{n.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="sheet-foot t-mono">
        <span class="sheet-check" aria-hidden="true">✓</span><span>ready for real users, data and payments</span>
      </p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 9vw, 7.5rem);
  }
  .hero-grid {
    row-gap: 3.5rem;
    align-items: end;
  }
  .hero-copy {
    grid-column: 1 / -1;
  }
  .hero-title {
    margin: 1.75rem 0 0;
    max-width: 17ch;
  }
  .hero-sub {
    margin: 1.75rem 0 0;
    max-width: 40ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
  }

  .hero-sheet {
    grid-column: 1 / -1;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }
  .sheet-list {
    margin: 0;
    padding: 0.4rem 1.1rem;
  }
  .sheet-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px dashed var(--color-rule);
  }
  .sheet-row:last-child {
    border-bottom: 0;
  }
  .sheet-row dt {
    color: var(--color-ink-muted);
    padding-top: 0.12rem;
  }
  .sheet-row dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .sheet-foot {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    margin: 0;
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink);
  }
  .sheet-check {
    color: var(--color-signal-ink);
  }

  @media (width >= 56.25rem) {
    .hero-copy {
      grid-column: 1 / span 8;
    }
    .hero-sheet {
      grid-column: 9 / span 4;
    }
  }
</style>
