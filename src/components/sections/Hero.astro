---
import VersionTag from '../ui/VersionTag.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import ProductionLedger from './ProductionLedger.astro';

const notes = [
  { n: '01', text: 'Scoped first, then a fixed quote' },
  { n: '02', text: 'A staging link early in the build' },
  { n: '03', text: 'You own the repo, hosting and accounts' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-site grid-site hero-grid">
    <div class="hero-copy">
      <VersionTag />
      <h1 id="hero-title" class="hero-title">
        Past the prototype. <span class="t-quiet">SaaS and AI products that hold up with real users.</span>
      </h1>
      <p class="t-lead hero-sub">
        IsmailApps is a software product studio. We take products from an idea, or from what you built with AI
        tools, no-code or a freelancer, to software that holds up with real data and real payments. And we run our
        own.
      </p>
      <div class="hero-actions">
        <Button href="/contact" event="cta_click" location="hero" arrow>Start a project</Button>
        <TextLink href="/work">See our work</TextLink>
      </div>
    </div>
    <div class="hero-visual">
      <ProductionLedger />
    </div>
  </div>

  <div class="container-site">
    <ol class="hero-notes">
      {
        notes.map((note) => (
          <li>
            <span class="t-mono hero-note-n">{note.n}</span>
            <span>{note.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    /* No bottom padding: the next section's top space is the gap. */
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
  }
  .hero-grid {
    row-gap: 3rem;
    align-items: center;
  }
  .hero-copy,
  .hero-visual {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .hero-title {
    margin: 1.75rem 0 0;
    font-size: var(--step-5);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 15ch;
  }
  .hero-title .t-quiet {
    letter-spacing: -0.03em;
  }
  .hero-sub {
    margin: 1.75rem 0 0;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
  }
  .hero-notes {
    display: grid;
    gap: 0;
    list-style: none;
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .hero-notes li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-weight: 500;
  }
  .hero-note-n {
    color: var(--color-ink-muted);
  }
  /* Tablet: the ledger sits under the copy at a readable width, not stretched. */
  @media (width >= 40rem) and (width < 56.25rem) {
    .hero-visual {
      grid-column: 1 / span 6;
    }
  }
  @media (width >= 56.25rem) {
    .hero-copy {
      grid-column: 1 / span 7;
    }
    .hero-visual {
      grid-column: 8 / span 5;
    }
    .hero-notes {
      grid-template-columns: repeat(3, 1fr);
    }
    .hero-notes li {
      padding-right: 1.5rem;
      border-bottom: 0;
    }
    .hero-notes li + li {
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-rule);
    }
  }
</style>
