---
import SectionHeading from '../ui/SectionHeading.astro';
import FAQ from '../ui/FAQ.astro';

interface Props {
  items: { q: string; a: string }[];
  label?: string;
  title?: string;
  /** Use the homepage's wider frame. */
  wide?: boolean;
}
const { items, title = 'Questions founders ask', wide = false } = Astro.props;
---

<section class="section" aria-labelledby="faq-title">
  <div class:list={[wide ? 'container-wide' : 'container-site', 'grid-site faq-grid']}>
    <div class="faq-head">
      <SectionHeading id="faq-title" title={title} />
    </div>
    <div class="faq-list">
      <FAQ items={items} />
    </div>
  </div>
</section>

<style>
  .faq-grid {
    row-gap: 2.5rem;
  }
  .faq-head,
  .faq-list {
    grid-column: 1 / -1;
  }
  @media (width >= 56.25rem) {
    /* The heading stays in view while the questions scroll past. */
    .faq-head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .faq-list {
      grid-column: 5 / span 8;
    }
  }
</style>
