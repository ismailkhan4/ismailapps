---
/**
 * Our own product as real screenshots of the live site on desktop and phone.
 * The phone overlaps only the right edge of the desktop frame, so it never
 * covers the product's own headline.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const host = product.data.url ? new URL(product.data.url).hostname.replace(/^www\./, '') : '';
---

{
  product.data.cover && (
    <figure class="frames" data-reveal>
      <div class="desk">
        <div class="desk-bar" aria-hidden="true">
          <span class="dots">
            <i />
            <i />
            <i />
          </span>
          <span class="t-mono url">{host}</span>
        </div>
        <div class="desk-shot">
          <Image
            src={product.data.cover}
            alt={`The ${product.data.name} website on desktop`}
            widths={[640, 1100]}
            sizes="(min-width: 900px) 42vw, 80vw"
          />
        </div>
      </div>
      {product.data.mobileCover && (
        <div class="phone">
          <div class="phone-shot">
            <Image
              src={product.data.mobileCover}
              alt={`${product.data.name} on a phone`}
              widths={[240, 480]}
              sizes="10rem"
            />
          </div>
        </div>
      )}
    </figure>
  )
}

<style>
  .frames {
    position: relative;
    margin: 0;
    padding: 0 0 2.5rem;
  }
  .desk {
    width: 84%;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 80px -50px rgb(18 20 18 / 0.45);
  }
  .desk-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--color-rule);
  }
  .url {
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .desk-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .desk-shot :global(img),
  .phone-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(6.5rem, 27%, 10rem);
    padding: 0.35rem;
    background: var(--color-ink);
    border-radius: 1.5rem;
    box-shadow: 0 30px 50px -24px rgb(18 20 18 / 0.55);
  }
  .phone-shot {
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 1.2rem;
  }
</style>
