---
/**
 * Proof strip as an editorial index of everything we've shipped. On devices that
 * can hover, a real screenshot trails the cursor over each row (motion.ts).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getProducts, getWork, workHref } from '../../lib/content';

interface Props {
  label?: string;
  /** Defaults to all work entries. */
  work?: CollectionEntry<'work'>[];
  /** Include our own products (default true). */
  products?: boolean;
}
const { label = 'index · shipped and running', work: only, products: withProducts = true } = Astro.props;

type Row = { key: string; name: string; meta: string; href: string; cover?: ImageMetadata | undefined; ours?: boolean };
const work = only ?? (await getWork());
const products = withProducts ? await getProducts() : [];
const rows: Row[] = [
  ...work.map((w) => ({
    key: w.id,
    name: w.data.title,
    meta: `${w.data.category} · ${w.data.clientLocation}`,
    href: workHref(w),
    cover: w.data.cover,
  })),
  ...products.map((p) => ({
    key: p.id,
    name: p.data.name,
    meta: 'Our own product',
    href: `/products/${p.id}`,
    cover: p.data.cover,
    ours: true,
  })),
];
---

<section class="index" aria-labelledby="index-title">
  <div class="container-site">
    <div class="index-head">
      <h2 id="index-title" class="t-label">{label}</h2>
      <p class="t-label index-count">{String(rows.length).padStart(2, '0')} entries</p>
    </div>
    <ol class="index-list" data-preview-list>
      {
        rows.map((r, i) => (
          <li>
            <a href={r.href} class="index-row" data-preview-key={r.key}>
              <span class="t-mono index-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="index-name">{r.name}</span>
              <span class:list={['t-mono index-meta', r.ours && 'is-ours']}>{r.meta}</span>
              <span class="index-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="index-preview" data-preview aria-hidden="true">
    {
      rows.map(
        (r) =>
          r.cover && (
            <Image src={r.cover} alt="" width={480} loading="lazy" data-key={r.key} class="index-img" />
          ),
      )
    }
  </div>
</section>

<style>
  /* No bottom padding: the next section's own top space is the gap (avoids a doubled gap). */
  .index {
    padding-block: var(--section-space) 0;
  }
  .index-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .index-head h2,
  .index-head p {
    margin: 0;
    font-weight: 400;
    letter-spacing: 0;
  }
  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .index-list li {
    border-bottom: 1px solid var(--color-rule);
  }
  .index-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }
  .index-n {
    color: var(--color-ink-muted);
  }
  .index-name {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    transition:
      transform 500ms cubic-bezier(0.2, 0.7, 0, 1),
      color 300ms;
  }
  .index-meta {
    grid-column: 2;
    color: var(--color-ink-muted);
  }
  .is-ours {
    color: var(--color-signal-ink);
  }
  .index-arrow {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    font-size: 1.5rem;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .index-row:hover .index-name,
  .index-row:focus-visible .index-name {
    transform: translateX(0.75rem);
    color: var(--color-signal-ink);
  }
  .index-row:hover .index-arrow,
  .index-row:focus-visible .index-arrow {
    transform: translateX(0.5rem) rotate(-45deg);
  }
  /* Dim the other rows while one is hovered. */
  @media (hover: hover) {
    .index-list:hover .index-row:not(:hover) .index-name {
      color: var(--color-rule);
    }
  }
  @media (width >= 56.25rem) {
    .index-row {
      grid-template-columns: 3.5rem 1fr 16rem 3rem;
      align-items: center;
    }
    .index-meta {
      grid-column: 3;
    }
    .index-arrow {
      grid-column: 4;
      justify-self: end;
    }
  }

  /* The trailing preview (only shown by motion.ts on hover devices). */
  .index-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 20rem;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    pointer-events: none;
    background: var(--color-ink);
    box-shadow: 0 30px 60px -20px rgb(23 21 15 / 0.45);
    opacity: 0;
    scale: 0.85;
    rotate: -3deg;
    transition:
      opacity 250ms var(--ease-precise),
      scale 400ms cubic-bezier(0.2, 0.7, 0, 1),
      rotate 400ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .index-preview:global(.is-active) {
    opacity: 1;
    scale: 1;
    rotate: 2deg;
  }
  .index-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 250ms;
  }
  .index-img.is-shown {
    opacity: 1;
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .index-preview {
      display: none;
    }
  }
</style>
