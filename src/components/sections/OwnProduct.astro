---
import TextLink from '../ui/TextLink.astro';
import ProductFrames from './ProductFrames.astro';
import { getProducts } from '../../lib/content';

const [product] = await getProducts();
---

{
  product && (
    <section class="section own" aria-labelledby="own-title">
      <div class="container-site grid-site own-grid">
        <div class="own-copy">
          <h2 id="own-title" class="t-h1 own-title">
            We run software too.
          </h2>
          <p class="own-tags">
            {product.data.status === 'live' && (
              <span class="tag tag-live">
                <span class="tag-dot" aria-hidden="true" />
                {product.data.statusNote ? `Live · ${product.data.statusNote}` : 'Live'}
              </span>
            )}
            <span class="tag tag-quiet">An IsmailApps product</span>
          </p>
          <p class="own-lead">
            <strong>{product.data.name}</strong> is ours: {product.data.summary.charAt(0).toLowerCase()}
            {product.data.summary.slice(1)}
          </p>
          <p class="own-why">
            Building and running our own product keeps our decisions honest: what to cut, what to ship first, and what
            breaks once real people depend on it. We bring the same judgement to client work.
          </p>
          {product.data.facts.length > 0 && (
            <ul class="own-facts t-mono">
              {product.data.facts.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          )}
          <div class="own-links">
            <TextLink href={`/products/${product.id}`}>About {product.data.name}</TextLink>
            {product.data.url && (
              <TextLink href={product.data.url} external event="outbound_hamstalk" location="own-product">
                Visit {new URL(product.data.url).hostname.replace(/^www\./, '')}
              </TextLink>
            )}
          </div>
        </div>
        <div class="own-visual">
          <ProductFrames product={product} />
        </div>
      </div>
    </section>
  )
}

<style>
  .own-grid {
    row-gap: 3.5rem;
    align-items: center;
  }
  .own-copy,
  .own-visual {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .own-title {
    margin: 0 0 1.25rem;
  }
  .own-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
  }
  .own-lead {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 44ch;
  }
  .own-why {
    margin: 1.25rem 0 0;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }
  .own-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px dashed var(--color-rule);
    color: var(--color-ink-muted);
  }
  .own-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  @media (width >= 56.25rem) {
    .own-copy {
      grid-column: 1 / span 5;
    }
    .own-visual {
      grid-column: 7 / span 6;
    }
  }
</style>
