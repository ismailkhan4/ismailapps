---
/**
 * Hero for inner pages, in the homepage's language: the drafting-board grid,
 * mono notes along the top edge, display type set across the full frame, and a
 * foot row with the promise, the actions and an optional aside.
 *
 * The title's last word arrives as a pencil outline (the brand's draft state)
 * and is filled in to solid ink: every page "ships" as it opens, like the
 * homepage's headline. Reduced motion shows it solid straight away. The fill is
 * a pseudo-element with empty alt text, so assistive tech reads the title once.
 */
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';

interface Props {
  crumbs: { href?: string; label: string }[];
  /** Small note above the headline. Leave out when it would just repeat the breadcrumb. */
  kicker?: string | undefined;
  /** Optional status pill next to the kicker (e.g. "live · early access"). */
  tag?: string | undefined;
  title: string;
  lead: string;
  /** Primary button. `event` defaults to cta_click; external links get ↗ and open normally. */
  cta?: { href: string; location: string; label?: string; event?: string } | undefined;
  secondary?: { href: string; label: string };
}
const { crumbs, kicker, tag, title, lead, cta, secondary } = Astro.props;
const hasAside = Astro.slots.has('aside');

const words = title.trim().split(/\s+/);
const last = words.pop() ?? '';
const head = words.join(' ');
// Long headlines (service promises, taglines) get a smaller display size.
const size = title.length > 28 ? 'long' : 'short';
---

<section class:list={['page-hero', 'has-board', hasAside && 'has-aside']} aria-labelledby="page-title">
  <div class="drafting-board" aria-hidden="true"></div>

  <div class="container-site page-hero-top">
    <Breadcrumbs items={crumbs} />
    {
      (kicker || tag) && (
        <p class="t-mono page-kicker">
          {kicker && <span>{kicker}</span>}
          {tag && (
            <span class="page-tag">
              <span class="page-tag-dot" aria-hidden="true" />
              {tag}
            </span>
          )}
        </p>
      )
    }
  </div>

  <div class="container-site grid-site page-hero-body">
    <h1 id="page-title" class:list={['page-title', `is-${size}`]}>
      <span class="page-title-text">{head && <>{head} </>}<span class="draft-word" data-text={last}>{last}</span></span>
    </h1>
    <div class="page-hero-copy">
      <p class="page-lead">{lead}</p>
      {
        (cta || secondary) && (
          <div class="page-actions">
            {cta && (
              <Button href={cta.href} event={cta.event ?? 'cta_click'} location={cta.location} arrow class="btn-sweep">
                {cta.label ?? 'Start a project'}
              </Button>
            )}
            {secondary && <TextLink href={secondary.href}>{secondary.label}</TextLink>}
          </div>
        )
      }
    </div>
    {
      hasAside && (
        <div class="page-hero-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .page-hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
  }
  .page-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
    color: var(--color-ink-muted);
  }
  .page-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.15em 0.6em;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .page-tag-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--color-signal);
  }

  /* ---------- The headline ---------- */
  .page-title {
    margin: 0;
    font-weight: 600;
    text-wrap: balance;
  }
  .page-title.is-short {
    font-size: clamp(3.25rem, 1rem + 8.2vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .page-title.is-long {
    font-size: clamp(2.6rem, 1rem + 5vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  /* The measure sits on the text, not the frame, so the frame's edges stay put. */
  .page-title-text {
    display: block;
    max-width: 15ch;
  }
  .is-long .page-title-text {
    max-width: 19ch;
  }
  /* ---------- Body: headline, then promise · actions; an aside sits alongside ---------- */
  .page-hero-body {
    row-gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .page-title,
  .page-hero-copy,
  .page-hero-aside {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .page-lead {
    margin: 0;
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
  }
  @media (width >= 56.25rem) {
    .page-hero-copy {
      grid-column: 1 / span 7;
    }
    .has-aside .page-title {
      grid-column: 1 / span 8;
    }
    .page-hero-aside {
      grid-column: 9 / span 4;
      grid-row: 1 / span 2;
      align-self: end;
    }
  }

  /* ---------- Entrance (CSS only; content never waits on JS) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .page-title {
      animation: title-rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .page-hero-top,
    .page-hero-copy {
      animation: rise 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .page-hero-copy {
      animation-delay: 350ms;
    }
    .page-hero-aside {
      animation: rise 1100ms cubic-bezier(0.2, 0.7, 0, 1) 500ms both;
    }
  }
  @keyframes title-rise {
    from {
      opacity: 0;
      transform: translateY(0.25em);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
