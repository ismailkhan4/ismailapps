---
/**
 * "How we work" as a release that compiles while you scroll (wide screens):
 *  - the paper opens into a full-bleed ink panel (--e: entry progress),
 *  - the section pins; a giant version number ticks v0.1 → v1.x, and its
 *    variable weight grows 400 → 900 with progress (--p): the product gains weight,
 *  - at v1.0 the number turns live green. Green means live, nothing else.
 * Narrow screens, reduced motion and no-JS get a plain ink panel with a list.
 */
type Step = { title: string; detail: string; v?: string | undefined };
interface Props {
  /** Plain-text title; the default is the homepage's "From first call to v1.0." */
  title?: string | undefined;
  sub?: string | undefined;
  /** Defaults to the studio's engagement process. */
  steps?: Step[] | undefined;
  /** Show the "you own" line under the steps. */
  ownership?: boolean;
  /** Joined to the ink section that follows (homepage reel): no bottom corners, no closing animation. */
  joined?: boolean;
  id?: string | undefined;
}

const defaultSteps: Step[] = [
  { v: 'v0.1', title: 'Scoping sprint', detail: 'We pressure-test the idea and agree scope, flows and architecture.' },
  { v: 'v0.3', title: 'Fixed quote', detail: 'A written plan and a fixed price before the build starts.' },
  { v: 'v0.6', title: 'Build, with staging access', detail: 'You click through a working staging build early in the project.' },
  { v: 'v1.0', title: 'Launch', detail: 'We deploy to your accounts and hand over.' },
  { v: 'v1.x', title: 'Ongoing care', detail: 'Maintenance and new features, or a clean handover to your team.' },
];

const {
  title,
  sub = 'One accountable lead, a fixed quote, and a staging link you can click early.',
  steps: input = defaultSteps,
  ownership = true,
  joined = false,
  id,
} = Astro.props;

// Steps without an explicit version count up evenly from v0.1 to v1.0.
const steps = input.map((s, i) => ({
  ...s,
  v: s.v ?? (i === input.length - 1 ? 'v1.0' : `v0.${1 + Math.round((i * 8) / Math.max(1, input.length - 1))}`),
}));
const first = steps[0]?.v ?? 'v0.1';
---

<section class:list={['build', joined && 'is-joined']} data-build data-joined={joined ? '' : undefined} id={id} aria-labelledby="build-title" data-theme="ink">
  <div class="build-stage" data-build-stage>
    <div class="build-panel">
      <div class="container-wide build-grid">
        <div class="build-left">
          <h2 id="build-title" class="build-title">
            {title ?? <Fragment>From first call to <span class="nowrap">v1.0</span>.</Fragment>}
          </h2>
          {sub && <p class="build-sub">{sub}</p>}
          <p class="build-counter" aria-hidden="true" data-build-counter>{first}</p>
          <ol class="build-bar" aria-hidden="true" style={`--n:${steps.length}`}>
            {steps.map(() => <li />)}
          </ol>
        </div>
        <ol class="build-steps">
          {
            steps.map((s, i) => (
              <li class="build-step" data-build-step={s.v} style={`--i:${i}`}>
                <span class="t-mono build-v">{s.v}</span>
                <div>
                  <h3 class="build-step-title">{s.title}</h3>
                  <p class="build-step-detail">{s.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      {ownership && (
      <div class="container-wide build-own">
        <p class="t-mono build-own-key"><span class="own-dot" aria-hidden="true"></span>you own</p>
        <p>
          The repository, hosting and accounts, from day one. If you ever want to work with someone else, nothing has to
          be handed back.
        </p>
      </div>
      )}
    </div>
  </div>
</section>

<style>
  .build {
    position: relative;
    --e: 1;
    --p: 0;
  }
  /* Build, reel and own product form one continuous ink room: rounded at the
     top here, rounded at the bottom by OwnProductStage. */
  .build-panel {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--section-space);
    margin-inline: clamp(0.5rem, 1.2vw, 1rem);
    border-radius: var(--radius-xl);
  }
  .build.is-joined .build-panel {
    margin-inline: 0;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }
  .build-panel :focus-visible {
    outline-color: var(--color-paper);
  }
  .build-grid {
    display: grid;
    gap: 2.5rem 4rem;
  }
  .build-title {
    margin: 0;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: 11ch;
  }
  .nowrap {
    white-space: nowrap;
  }
  .build-sub {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .build-counter,
  .build-bar {
    display: none;
  }
  .build-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .build-step {
    display: grid;
    grid-template-columns: 3.75rem 1fr;
    gap: 1rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--color-ink-rule);
  }
  .build-v {
    color: var(--color-ink-soft);
    padding-top: 0.25rem;
  }
  .build-step-title {
    margin: 0 0 0.35rem;
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .build-step-detail {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 44ch;
  }
  .build-own {
    display: grid;
    gap: 0.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink-rule);
  }
  .build-own p {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .build-own-key {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-paper) !important;
  }
  .own-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-signal);
  }

  @media (width >= 56.25rem) {
    .build-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .build-own {
      grid-template-columns: auto 1fr;
      align-items: baseline;
    }
  }

  /* ---------------- Pinned mode (set by home.ts) ---------------- */
  .build:global(.is-pinned) .build-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: stretch;
  }
  .build:global(.is-pinned) .build-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Clear the sticky header, then fit five steps on short laptop screens. */
    padding-block: calc(4.25rem + clamp(0.75rem, 3vh, 2rem)) clamp(1.25rem, 3vh, 2.5rem);
    margin-inline: 0;
    border-radius: 0;
    /* The panel opens from an inset card to full bleed as the section arrives.
       The side inset stays inside the gutter so the headline is never cut. */
    clip-path: inset(
      calc((1 - var(--e)) * 7vh) calc((1 - var(--e)) * var(--gutter) * 0.6) calc((1 - var(--e)) * 7vh)
        calc((1 - var(--e)) * var(--gutter) * 0.6) round calc(var(--radius-xl) * (1 - var(--e) * 0.999))
    );
  }
  .build:global(.is-pinned) .build-grid {
    align-items: center;
  }
  .build:global(.is-pinned) .build-counter {
    display: block;
    margin: clamp(1rem, 3vh, 2.5rem) 0 0;
    font-size: clamp(7rem, min(19vw, 32vh), 20rem);
    font-weight: calc(400 + var(--p) * 500);
    letter-spacing: -0.07em;
    line-height: 0.82;
    color: var(--color-paper);
    transition: color 500ms var(--ease-precise);
  }
  .build:global(.is-live) .build-counter {
    color: var(--color-signal);
  }
  .build-counter:global(.tick) {
    animation: tick 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .build:global(.is-pinned) .build-bar {
    display: grid;
    grid-template-columns: repeat(var(--n, 5), 1fr);
    gap: 0.4rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    max-width: 30rem;
  }
  .build-bar li {
    height: 0.4rem;
    border: 1px dashed var(--color-ink-soft);
    border-radius: 2px;
    transition:
      background-color 400ms var(--ease-precise),
      border-color 400ms var(--ease-precise);
  }
  .build-bar li:global(.is-done) {
    background: var(--color-paper);
    border: 1px solid var(--color-paper);
  }
  .build:global(.is-live) .build-bar li:global(.is-done) {
    background: var(--color-signal);
    border-color: var(--color-signal);
  }
  /* Steps dim by colour (ink-soft stays 7.6:1), never opacity. The current
     step's content shifts; its divider line stays put. */
  .build:global(.is-pinned) .build-step {
    padding-block: clamp(0.8rem, 2.1vh, 1.35rem);
  }
  .build:global(.is-pinned) .build-step > * {
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .build:global(.is-pinned) .build-own {
    margin-top: clamp(1.25rem, 4vh, 3.5rem);
    padding-top: clamp(1rem, 2vh, 1.5rem);
  }
  .build:global(.is-pinned) .build-own p {
    max-width: none;
  }
  /* Short laptop screens (≈768–820px tall): slightly tighter type so every step fits. */
  @media (max-height: 51.25rem) {
    .build:global(.is-pinned) .build-step-title {
      font-size: 1.1875rem;
    }
    .build:global(.is-pinned) .build-step-detail {
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }
  .build:global(.is-pinned) .build-step-title {
    color: var(--color-ink-soft);
    transition: color 400ms var(--ease-precise);
  }
  .build:global(.is-pinned) .build-step:global(.is-current) > * {
    transform: translateX(-0.75rem);
  }
  .build:global(.is-pinned) .build-step:global(.is-current) .build-step-title,
  .build:global(.is-pinned) .build-step:global(.is-current) .build-step-detail,
  .build:global(.is-pinned) .build-step:global(.is-current) .build-v {
    color: var(--color-paper);
  }
  .build:global(.is-pinned) .build-step:global(.is-done) .build-v {
    color: var(--color-paper);
  }
  @keyframes tick {
    from {
      opacity: 0;
      transform: translateY(0.18em);
      filter: blur(10px);
    }
  }
</style>
