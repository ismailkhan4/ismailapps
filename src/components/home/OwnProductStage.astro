---
/**
 * Our own product, Hamstalk, as a layered stage: a huge outlined wordmark in
 * the back, the real desktop screenshot in the middle, the real phone
 * screenshot in front. Layers shift by depth with the pointer and with scroll
 * (home.ts sets --mx/--my/--sp); touch and reduced motion get the still layout.
 */
import { Image } from 'astro:assets';
import { getProducts } from '../../lib/content';

interface Props {
  /** Not joined to an ink section above it: inset card with all corners rounded. */
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const [product] = await getProducts();
const host = product?.data.url ? new URL(product.data.url).hostname.replace(/^www\./, '') : '';
---

{
  product && (
    <section class:list={['own', standalone && 'is-standalone']} data-depth-stage data-theme="ink" aria-labelledby="own-title">
      <div class="own-back" aria-hidden="true">
        <span class="own-word" data-depth="-0.4">
          {product.data.name}
        </span>
      </div>

      <div class="container-wide own-grid">
        <div class="own-copy">
          <p class="t-mono own-status">
            {product.data.status === 'live' && <span class="own-dot" aria-hidden="true" />}
            {product.data.status === 'live' ? 'live' : 'offline'}
            {product.data.statusNote && ` · ${product.data.statusNote}`} · an IsmailApps product
          </p>
          <h2 id="own-title" class="own-title">
            We run software too.
          </h2>
          <p class="own-lead">
            <strong>{product.data.name}</strong> is ours from the first sketch to the server bill:{' '}
            {product.data.summary.charAt(0).toLowerCase()}
            {product.data.summary.slice(1)}
          </p>
          <p class="own-why">
            Running our own product keeps our decisions honest: what to cut, what to ship first, and what breaks once
            real people depend on it. Client work gets the same judgement.
          </p>
          <ul class="t-mono own-facts">
            {product.data.facts.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <div class="own-links">
            <a href={`/products/${product.id}`} class="link">
              About {product.data.name} <span class="link-arrow" aria-hidden="true">→</span>
            </a>
            {product.data.url && (
              <a
                href={product.data.url}
                class="link"
                rel="noopener"
                data-umami-event="outbound_hamstalk"
                data-umami-event-location="home-own-product"
              >
                Visit {host} <span class="link-arrow link-arrow-external" aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>

        <figure class="own-visual">
          {product.data.cover && (
            <div class="own-desk" data-depth="0.5">
              <div class="own-bar" aria-hidden="true">
                <span class="own-dots">
                  <i />
                  <i />
                  <i />
                </span>
                <span class="t-mono own-host">{host}</span>
              </div>
              <div class="own-desk-shot">
                <Image
                  src={product.data.cover}
                  alt={`The ${product.data.name} website on desktop`}
                  widths={[640, 1100]}
                  sizes="(min-width: 900px) 46vw, 90vw"
                  loading="lazy"
                />
              </div>
            </div>
          )}
          {product.data.mobileCover && (
            <div class="own-phone" data-depth="1.3">
              <div class="own-phone-shot">
                <Image
                  src={product.data.mobileCover}
                  alt={`${product.data.name} on a phone`}
                  widths={[240, 480]}
                  sizes="12rem"
                  loading="lazy"
                />
              </div>
            </div>
          )}
        </figure>
      </div>
    </section>
  )
}

<style>
  .own {
    position: relative;
    isolation: isolate;
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: clamp(3rem, 7vw, 6rem) var(--section-space);
    overflow: clip;
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  }
  .own.is-standalone {
    margin-inline: clamp(0.5rem, 1.2vw, 1rem);
    padding-top: var(--section-space);
    border-radius: var(--radius-xl);
  }
  .own :focus-visible {
    outline-color: var(--color-paper);
  }
  [data-depth] {
    translate: calc(var(--mx, 0) * var(--k, 0) * 1.6rem) calc((var(--my, 0) * 1.2rem + var(--sp, 0) * -6rem) * var(--k, 0));
    will-change: translate;
  }
  .own-word {
    --k: -0.4;
  }
  .own-desk {
    --k: 0.5;
  }
  .own-phone {
    --k: 1.3;
  }

  .own-back {
    position: absolute;
    inset: auto 0 6% 0;
    z-index: -1;
    display: flex;
    justify-content: center;
    pointer-events: none;
    user-select: none;
  }
  .own-word {
    display: block;
    font-size: clamp(6rem, 24vw, 26rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-ink-rule);
    white-space: nowrap;
  }

  .own-grid {
    display: grid;
    gap: 3.5rem 4rem;
    align-items: center;
  }
  .own-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-ink-soft);
  }
  .own-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-signal);
  }
  .own-title {
    margin: 1rem 0 1.5rem;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: 10ch;
  }
  .own-lead {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 42ch;
  }
  .own-why {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    max-width: 48ch;
  }
  .own-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px dashed var(--color-ink-rule);
    color: var(--color-ink-soft);
  }
  .own-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .own-visual {
    position: relative;
    margin: 0;
    padding: 0 0 3rem;
  }
  .own-desk {
    width: 86%;
    border-radius: var(--radius-lg);
    background: var(--color-ink-raised);
    outline: 1px solid var(--color-ink-rule);
    overflow: hidden;
    box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.7);
  }
  .own-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--color-ink-rule);
  }
  .own-dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .own-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--color-ink-rule);
  }
  .own-host {
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }
  .own-desk-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .own-desk-shot :global(img),
  .own-phone-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .own-phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(7rem, 30%, 12rem);
    padding: 0.4rem;
    background: #050605;
    border-radius: 1.6rem;
    outline: 1px solid var(--color-ink-rule);
    box-shadow: 0 40px 60px -20px rgb(0 0 0 / 0.75);
  }
  .own-phone-shot {
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 1.25rem;
  }

  @media (width >= 56.25rem) {
    .own-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-depth] {
      translate: none;
    }
  }
</style>
