---
/**
 * What we build, framed by where the visitor's product is today.
 * Each state is set as giant type whose *fill* is its state:
 *   v0 an idea → pencil outline, v0.x a prototype → half built, v1.x live → solid.
 * The fill sweeps in, scrubbed by scroll (home.ts writes --fill per row).
 * Descriptions and service links are always visible: nothing hides behind hover.
 */
import { getServices } from '../../lib/content';

interface Props {
  /** Link to the services overview (off on that page itself). */
  allLink?: boolean;
}
const { allLink = true } = Astro.props;
const services = await getServices();
const byId = (id: string) => services.find((s) => s.id === id)!;

const rows = [
  {
    v: 'v0',
    title: 'An idea.',
    target: 0,
    line: 'You know the problem and the customer. Nothing is built yet, or only sketches.',
    paths: [byId('scoping-sprint'), byId('product-development')],
  },
  {
    v: 'v0.x',
    title: 'A prototype that strains.',
    target: 0.55,
    line: 'Built with AI tools, no-code or a freelancer. It demos well, and breaks once real users arrive.',
    paths: [byId('prototype-to-production')],
    note: 'our specialty',
  },
  {
    v: 'v1.x',
    title: 'A live product.',
    target: 1,
    line: 'Customers depend on it. You need features, AI work, integrations or upkeep without a new hire.',
    paths: [byId('product-engineering')],
    live: true,
  },
];

const disciplines = ['SaaS products', 'AI features', 'Web apps', 'Mobile apps', 'Integrations', 'Product engineering'];
const websites = byId('websites');
---

<section class="stages" aria-labelledby="stages-title">
  <div class="container-wide stages-head">
    <h2 id="stages-title" class="stages-title">Where is your product today?</h2>
    <p class="stages-intro">
      Most projects start in one of three places. Each has a clear first step, and we take it from there to
      production.
    </p>
  </div>

  <ol class="rows">
    {
      rows.map((r) => (
        <li class:list={['row', r.live && 'is-live']} data-fill-row style={`--target:${r.target}`}>
          <div class="container-wide row-inner">
            <p class="t-mono row-v">
              <span class:list={['row-tag', r.live ? 'tag-solid' : 'tag-dashed']}>
                {r.live && <span class="row-dot" aria-hidden="true" />}
                {r.v}
              </span>
              {r.note && <span class="row-note">{r.note}</span>}
            </p>
            <h3 class="row-title">
              <span class="row-ink" data-text={r.title}>
                {r.title}
              </span>
            </h3>
            <div class="row-body">
              <p class="row-line">{r.line}</p>
              <ul class="row-paths">
                {r.paths.map((p) => (
                  <li>
                    <a href={`/services/${p.id}`} class="row-path">
                      <span class="row-path-title">{p.data.title}</span>
                      <span class="row-path-arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="container-wide stages-foot">
    <p class="t-mono stages-foot-label">What we build</p>
    <ul class="disciplines">
      {disciplines.map((d) => <li>{d}</li>)}
    </ul>
    <p class="stages-web">
      We also build <a href={`/services/${websites.id}`}>websites</a> for software and service businesses
      {
        allLink && (
          <>
            {' · '}
            <a href="/services">all services</a>
          </>
        )
      }
    </p>
  </div>
</section>

<style>
  .stages {
    padding-block: var(--section-space) clamp(3rem, 6vw, 5rem);
  }
  .stages-head {
    display: grid;
    gap: 1.25rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .stages-title {
    margin: 0;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .stages-intro {
    margin: 0;
    max-width: 38ch;
    color: var(--color-ink-muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .row {
    border-bottom: 1px solid var(--color-rule);
    transition: background-color 400ms var(--ease-precise);
  }
  .row:hover {
    background: var(--color-surface);
  }
  .row-inner {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }
  .row-v {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 0;
  }
  .row-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }
  .tag-dashed {
    border: 1px dashed var(--color-ink-muted);
    color: var(--color-ink-muted);
  }
  .tag-solid {
    border: 1px solid var(--color-ink);
    background: var(--color-surface);
  }
  .row-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--color-signal);
  }
  .row-note {
    color: var(--color-ink-muted);
  }

  /* Giant title: outline underneath, solid ink clipped to --fill (0–1). */
  .row-title {
    margin: 0;
    font-size: clamp(2.4rem, 7.4vw, 7.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 600;
    text-wrap: balance;
  }
  .row-ink {
    position: relative;
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: max(1px, 0.012em) var(--color-ink-muted);
    transition: font-weight 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .row-ink::after {
    content: attr(data-text);
    /* Empty alt text: screen readers must not read the title twice. */
    content: attr(data-text) / '';
    position: absolute;
    inset: 0;
    color: var(--color-ink);
    -webkit-text-stroke: 0;
    clip-path: inset(-0.2em calc((1 - var(--fill, var(--target))) * 100%) -0.2em -0.1em);
  }
  /* The build caret: where the work has got to. Hidden once fully built. */
  .row-ink::before {
    content: '';
    position: absolute;
    top: -0.05em;
    bottom: -0.05em;
    left: calc(var(--fill, var(--target)) * 100%);
    width: 2px;
    background: var(--color-ink);
    opacity: calc(1 - var(--fill, var(--target)));
  }
  .is-live .row-ink::before {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .row:not(.is-live) .row-ink::before {
      animation: caret 1.1s steps(1) infinite;
    }
  }
  @keyframes caret {
    50% {
      visibility: hidden;
    }
  }
  .row:hover .row-ink,
  .row:focus-within .row-ink {
    font-weight: 800;
  }

  .row-body {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .row-line {
    margin: 0;
    color: var(--color-ink-muted);
    max-width: 40ch;
  }
  .row-paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .row-path {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.3rem;
    font-weight: 600;
    text-decoration: none;
  }
  .row-path-title {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 320ms var(--ease-precise);
  }
  .row-path:hover .row-path-title {
    background-size: 100% 1px;
  }
  .row-path-arrow {
    transition: transform 240ms var(--ease-precise);
  }
  .row-path:hover .row-path-arrow {
    transform: translateX(4px);
  }

  .stages-foot {
    display: grid;
    gap: 1rem 3rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: baseline;
  }
  .stages-foot-label {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.2em;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .disciplines li:not(:last-child)::after {
    content: ' /';
    color: var(--color-ink-muted);
    font-weight: 400;
    margin-right: 0.15em;
  }
  .stages-web {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .stages-web a {
    color: var(--color-ink);
    text-underline-offset: 0.2em;
  }

  @media (width >= 56.25rem) {
    .stages-head {
      grid-template-columns: 1fr auto;
    }
    .row-inner {
      grid-template-columns: 7rem minmax(0, 1fr) minmax(16rem, 22rem);
      align-items: center;
    }
    .row-v {
      align-self: start;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 0.9rem;
    }
    .stages-foot {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
    }
  }
</style>
