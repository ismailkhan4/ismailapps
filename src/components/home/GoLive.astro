---
/**
 * Closing moment: the only full signal-green surface on a page. The release
 * reaches "live" here, and the visitor answers the page's question by picking
 * where their product is; each choice opens the project form pre-filled
 * (?service= & ?stage=, read by src/scripts/inquiry.ts).
 * Used on the homepage directly and on every other page through CTASection.
 * With `href` (service pages, already pre-filled) it shows one button instead.
 * White on signal-ink is 6.6:1.
 */
import { site } from '../../lib/site';

interface Props {
  /** Analytics location prefix for the CTA clicks. */
  location?: string;
  /** Closing line under the choices. */
  sub?: string;
  /** A single pre-filled destination instead of the three stage choices. */
  href?: string | undefined;
  /** Homepage frame (wide) or the standard content frame. */
  wide?: boolean;
}
const {
  location = 'home-golive',
  sub = 'We reply by email and tell you honestly what it needs next. No sales script.',
  href,
  wide = true,
} = Astro.props;

const choices = [
  { v: 'v0', label: 'An idea', href: '/contact?service=new-product&stage=idea' },
  { v: 'v0.x', label: 'A prototype', href: '/contact?service=prototype-to-production&stage=prototype' },
  { v: 'v1.x', label: 'A live product', href: '/contact?service=saas-engineering&stage=live' },
];
---

<section class="golive" aria-labelledby="golive-title" data-theme="live">
  <div class={wide ? 'container-wide' : 'container-site'}>
    <p class="t-mono golive-k"><span class="golive-dot" aria-hidden="true"></span>ready to ship</p>
    <h2 id="golive-title" class="golive-title">Tell us where your product is today.</h2>
    {
      href ? (
        <div class="golive-single">
          <p>{sub}</p>
          <a href={href} class="btn btn-sweep golive-btn" data-umami-event="cta_click" data-umami-event-location={location}>
            Start a project <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      ) : (
        <ul class="choices" aria-label="Where is your product today?">
          {choices.map((c) => (
            <li>
              <a href={c.href} class="choice" data-umami-event="cta_click" data-umami-event-location={`${location}-${c.v}`}>
                <span class="t-mono choice-v">{c.v}</span>
                <span class="choice-label">{c.label}</span>
                <span class="choice-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <div class="golive-foot">
      {!href && <p>{sub}</p>}
      <a href={`mailto:${site.email}`} class="t-mono golive-mail">{site.email}</a>
    </div>
  </div>
</section>

<style>
  .golive {
    margin: clamp(0.5rem, 1.2vw, 1rem);
    padding-block: clamp(4rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--color-signal-ink);
    color: var(--color-white);
  }
  .golive :focus-visible {
    outline-color: var(--color-white);
  }
  .golive-k {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-signal-tint);
  }
  .golive-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-white);
  }
  @media (prefers-reduced-motion: no-preference) {
    .golive-dot {
      animation: breathe 2.4s ease-in-out infinite;
    }
  }
  .golive-title {
    margin: 1.25rem 0 0;
    font-size: clamp(3rem, 1.4rem + 7vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    max-width: 12ch;
  }
  .choices {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 55%, transparent);
  }
  .choices li {
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 55%, transparent);
  }
  .choice {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 2vw, 1.5rem) 0.25rem;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      color 420ms cubic-bezier(0.65, 0, 0.35, 1),
      padding 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Paper sweeps in from the left; the row turns to ink. */
  .choice::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-paper);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .choice:hover,
  .choice:focus-visible {
    color: var(--color-ink);
    padding-inline: 1.25rem;
  }
  .choice:hover::before,
  .choice:focus-visible::before {
    transform: scaleX(1);
  }
  .choice-v {
    color: inherit;
    opacity: 0.85;
  }
  .choice-label {
    font-size: clamp(1.75rem, 4.4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .choice-arrow {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .choice:hover .choice-arrow,
  .choice:focus-visible .choice-arrow {
    transform: translateX(0.4rem) rotate(-45deg);
  }
  .golive-single {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 55%, transparent);
  }
  /* Paper button on green; the global sweep turns it ink on hover. */
  .golive-btn {
    min-height: 3.75rem;
    padding-inline: 2rem;
    font-size: 1.125rem;
    background: var(--color-paper);
    color: var(--color-ink);
    transition: color 460ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .golive-btn:hover {
    color: var(--color-paper);
  }
  .golive-single p {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 36ch;
  }
  .golive-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }
  .golive-single p,
  .golive-foot p {
    margin: 0;
    color: var(--color-signal-tint);
    max-width: 44ch;
  }
  .golive-mail {
    color: var(--color-white);
    text-underline-offset: 0.25em;
  }
  @keyframes breathe {
    50% {
      opacity: 0.35;
    }
  }
</style>
