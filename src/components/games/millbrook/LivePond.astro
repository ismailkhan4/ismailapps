---
/** The game's live pond in a frame, with feeding and time of day. Drawn by the game's own WebGL renderer. */
---

<section class="pond-section" aria-label="The live pond">
  <div class="container-site">
    <div class="pond-frame">
      <canvas data-pond aria-label="A live koi pond. Tap the water to make ripples, or tap a koi to meet it."></canvas>
      <p class="pond-fallback" data-fallback hidden>This browser can't draw the live pond (it needs WebGL2). The rest of the page works.</p>
      <div class="koi-card" data-card hidden aria-live="polite">
        <button class="koi-card-x" type="button" data-close aria-label="Close">×</button>
        <p class="koi-card-name" data-c-name></p>
        <p class="koi-card-var" data-c-var></p>
        <p class="koi-card-note" data-c-note></p>
        <p class="t-mono koi-card-facts" data-c-facts></p>
      </div>
    </div>
    <div class="pond-bar" data-bar>
      <p class="pond-hint" data-hint>This is the game running live. Tap the water, or tap a koi to meet it.</p>
      <div class="pond-controls">
        <button class="btn btn-secondary pond-feed" type="button" data-feed aria-pressed="false">Feed the koi</button>
        <div class="pond-time" role="group" aria-label="Time of day in the pond">
          <button type="button" data-hour="6.6">Dawn</button>
          <button type="button" data-hour="12.5">Noon</button>
          <button type="button" data-hour="18.9">Dusk</button>
          <button type="button" data-hour="22.6">Night</button>
          <button type="button" data-hour="live" aria-pressed="true">Now</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createPond } from '../../../games/millbrook/engine';
  import { VARIETY_INFO, type Koi } from '../../../games/millbrook/koi';

  const root = document.querySelector<HTMLElement>('.pond-section')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-pond]')!;
  const card = root.querySelector<HTMLElement>('[data-card]')!;
  const $ = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`)!;

  const show = (k: Koi) => {
    const info = VARIETY_INFO[k.variety];
    $('c-name').textContent = k.name;
    $('c-var').textContent = info.label;
    $('c-note').textContent = info.note;
    $('c-facts').textContent = `${k.lengthCm} cm, ${k.ageYears} ${k.ageYears === 1 ? 'year' : 'years'} old. ${k.personality}.`;
    card.hidden = false;
  };

  const pond = createPond(canvas, {
    fish: ['kohaku', 'tancho', 'sanke', 'showa', 'ogon', 'chagoi', 'kohaku'],
    pads: [[0.1, 0.18, 1], [0.2, 0.3, 0.6], [0.86, 0.2, 1.1], [0.95, 0.34, 0.6], [0.82, 0.78, 0.9], [0.4, 0.88, 0.75]],
    maxDpr: 1.5,
    reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
    onFish: show,
    onTap: () => { card.hidden = true; },
  });

  if (!pond) {
    canvas.hidden = true;
    $('fallback').hidden = false;
    $('bar').hidden = true;
  } else {
    const feed = $('feed');
    feed.addEventListener('click', () => {
      const on = feed.getAttribute('aria-pressed') !== 'true';
      feed.setAttribute('aria-pressed', String(on));
      feed.textContent = on ? 'Stop feeding' : 'Feed the koi';
      pond.setFeed(on);
      $('hint').textContent = on ? 'Tap the water to scatter food. The bold koi come first.' : 'This is the game running live. Tap the water, or tap a koi to meet it.';
    });
    $('close').addEventListener('click', () => { card.hidden = true; });
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-hour]')];
    chips.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.hour!;
      pond.setHour(v === 'live' ? 'live' : Number(v));
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    }));
  }
</script>

<style>
  .pond-section {
    padding-bottom: var(--section-space);
  }
  .pond-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: #0f2e2b;
  }
  .pond-frame canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: pointer;
    touch-action: manipulation;
  }
  .pond-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 2rem;
    text-align: center;
    color: var(--color-white);
  }
  .koi-card {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: min(18rem, calc(100% - 2rem));
    padding: 1rem 1.1rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.6);
  }
  .koi-card p {
    margin: 0;
  }
  .koi-card-name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .koi-card-var {
    font-weight: 600;
    color: var(--color-ink-muted);
  }
  .koi-card-note {
    margin-top: 0.5rem !important;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .koi-card-facts {
    margin-top: 0.6rem !important;
    color: var(--color-ink-muted);
  }
  .koi-card-x {
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-ink-muted);
    cursor: pointer;
  }
  .pond-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }
  .pond-hint {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .pond-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .pond-feed[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .pond-time {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-pill);
  }
  .pond-time button {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
  }
  .pond-time button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  @media (width < 40rem) {
    .pond-frame {
      aspect-ratio: 4 / 5;
    }
    .pond-time button {
      padding: 0 0.7rem;
    }
  }
</style>
