---
/**
 * A game's build status, written as a dev log in the studio's state language:
 * built things are set heavy with a solid koi dot; planned things are lighter with an open
 * lily ring (the same outline = not built, solid = built rule the studio pages use).
 * `compact` shows titles only (the /games overview); the game page shows the detail too.
 */
import { exists, planned } from '../../games/koimere/content';

interface Props {
  id?: string;
  title?: string;
  lead?: string;
  compact?: boolean;
  /** Link to the full log (compact only). */
  more?: { href: string; label: string };
}
const {
  id = 'status-title',
  title = 'Where the game is',
  lead = 'No lives, no energy bars, no timers and no loot boxes. Skip a week and the pond is just as you left it.',
  compact = false,
  more,
} = Astro.props;
const cols = [
  { key: 'built', head: 'Working today', items: exists },
  { key: 'planned', head: 'Coming next', items: planned },
] as const;
---

<section class:list={['section', 'status', compact && 'is-compact']} aria-labelledby={id}>
  <div class="container-site status-grid">
    <div class="status-intro">
      <h2 id={id} class="t-h2">{title}</h2>
      {lead && <p class="t-lead">{lead}</p>}
      {
        more && (
          <a href={more.href} class="link status-more">
            {more.label} <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    <div class="status-cols">
      {
        cols.map((c) => (
          <div class:list={['status-col', `is-${c.key}`]}>
            <h3 class="t-mono status-head">
              {c.head} <span class="status-count">{c.items.length}</span>
            </h3>
            <ul class="status-list">
              {c.items.map((p) => (
                <li>
                  <span class="status-mark" aria-hidden="true" />
                  <span class="status-body">
                    <strong class="status-title">{p.title}</strong>
                    {!compact && <span class="status-text">{p.text}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .status h2,
  .status p {
    margin: 0;
  }
  .status-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .status-intro {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .status-intro .t-lead {
    max-width: 34ch;
  }
  .status-more {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .status-cols {
    display: grid;
    gap: 2.5rem;
  }
  .status-head {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-ink);
    font-weight: 500;
  }
  .status-count {
    color: var(--color-ink-muted);
  }
  .status-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .status-list li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .status-mark {
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.45em;
    border-radius: 50%;
  }
  .is-built .status-mark {
    background: var(--color-koi);
  }
  .is-planned .status-mark {
    border: 1.5px solid var(--color-lily);
  }
  .status-body {
    display: grid;
    gap: 0.2rem;
  }
  .status-title {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .is-built .status-title {
    font-weight: 700;
  }
  .is-planned .status-title {
    font-weight: 450;
  }
  .status-text {
    color: var(--color-ink-muted);
    max-width: 46ch;
  }
  @media (width >= 56.25rem) {
    .status-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
    .status-cols {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
