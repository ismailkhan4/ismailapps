---
/**
 * The game's live pond, drawn by Koimere's own WebGL renderer, with feeding and time of day.
 *
 * variant="frame": a rounded frame inside the page grid.
 * variant="hero":  full-bleed stage at the top of a games page. The slot is laid over the
 *                  water (bottom-left, on a scrim) and must contain the page's h1; pass its id
 *                  as `labelledby`. Only links and buttons in the overlay take pointer events,
 *                  so the rest of the water stays tappable.
 * A real frame from the game sits underneath as a poster: it is the first paint (and the LCP),
 * and what people see if the browser has no WebGL2.
 */
import { Image } from 'astro:assets';
import cover from '../../../assets/games/koimere-cover.png';

interface Props {
  variant?: 'frame' | 'hero';
  labelledby?: string;
}
const { variant = 'frame', labelledby } = Astro.props;
const hero = variant === 'hero';
---

<section
  class:list={['pond-section', `is-${variant}`]}
  aria-label={labelledby ? undefined : 'The live pond'}
  aria-labelledby={labelledby}
>
  <div class:list={['pond-stage', !hero && 'container-site']}>
    <div class="pond-frame" data-water={hero ? '' : undefined}>
      <Image
        src={cover}
        alt=""
        class="pond-poster"
        widths={[640, 1024, 1600, 2200]}
        sizes={hero ? '100vw' : '(min-width: 104rem) 100rem, 100vw'}
        loading="eager"
        fetchpriority="high"
      />
      <canvas data-pond aria-label="A live koi pond. Tap the water to make ripples, or tap a koi to meet it."></canvas>
      {hero && (
        <div class="pond-overlay">
          <div class="container-site pond-overlay-inner"><slot /></div>
        </div>
      )}
      <div class="koi-card" data-card hidden aria-live="polite">
        <button class="koi-card-x" type="button" data-close aria-label="Close">×</button>
        <p class="koi-card-name" data-c-name></p>
        <p class="koi-card-var" data-c-var></p>
        <p class="koi-card-note" data-c-note></p>
        <p class="t-mono koi-card-facts" data-c-facts></p>
      </div>
    </div>
  </div>
  <div class="container-site">
    <p class="pond-fallback" data-fallback hidden>This browser can't run the live pond (it needs WebGL2), so you're seeing a still frame from the game.</p>
    <div class="pond-bar" data-bar>
      <p class="pond-hint" data-hint>
        <span class="pond-live-dot" aria-hidden="true"></span>
        <span data-hint-text>This is the game running live. Tap the water, or tap a koi to meet it.</span>
      </p>
      <div class="pond-controls">
        <button class="btn btn-secondary pond-feed" type="button" data-feed aria-pressed="false">Feed the koi</button>
        <div class="pond-time" role="group" aria-label="Time of day in the pond">
          <button type="button" data-hour="6.6">Dawn</button>
          <button type="button" data-hour="12.5">Noon</button>
          <button type="button" data-hour="18.9">Dusk</button>
          <button type="button" data-hour="22.6">Night</button>
          <button type="button" data-hour="live" aria-pressed="true">Now</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createPond } from '../../../games/koimere/engine';
  import { VARIETY_INFO, type Koi } from '../../../games/koimere/koi';

  const root = document.querySelector<HTMLElement>('.pond-section')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-pond]')!;
  const card = root.querySelector<HTMLElement>('[data-card]')!;
  const $ = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`)!;

  const show = (k: Koi) => {
    const info = VARIETY_INFO[k.variety];
    $('c-name').textContent = k.name;
    $('c-var').textContent = info.label;
    $('c-note').textContent = info.note;
    $('c-facts').textContent = `${k.lengthCm} cm, ${k.ageYears} ${k.ageYears === 1 ? 'year' : 'years'} old. ${k.personality}.`;
    card.hidden = false;
  };

  const pond = createPond(canvas, {
    fish: ['kohaku', 'tancho', 'sanke', 'showa', 'ogon', 'chagoi', 'kohaku'],
    pads: [[0.1, 0.18, 1], [0.2, 0.3, 0.6], [0.86, 0.2, 1.1], [0.95, 0.34, 0.6], [0.82, 0.78, 0.9], [0.4, 0.88, 0.75]],
    maxDpr: 1.5,
    reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
    onFish: show,
    onTap: () => { card.hidden = true; },
  });

  if (!pond) {
    canvas.hidden = true;
    $('fallback').hidden = false;
    $('bar').hidden = true;
  } else {
    root.classList.add('is-running');
    const feed = $('feed');
    feed.addEventListener('click', () => {
      const on = feed.getAttribute('aria-pressed') !== 'true';
      feed.setAttribute('aria-pressed', String(on));
      feed.textContent = on ? 'Stop feeding' : 'Feed the koi';
      pond.setFeed(on);
      $('hint-text').textContent = on ? 'Tap the water to scatter food. The bold koi come first.' : 'This is the game running live. Tap the water, or tap a koi to meet it.';
    });
    $('close').addEventListener('click', () => { card.hidden = true; });
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-hour]')];
    chips.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.hour!;
      pond.setHour(v === 'live' ? 'live' : Number(v));
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    }));
  }
</script>

<style>
  .pond-section {
    padding-bottom: var(--section-space);
  }
  .pond-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-pond);
  }
  .pond-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pond-frame canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: pointer;
    touch-action: manipulation;
  }
  /* The poster stays until the renderer is running, then the water fades up over it. */
  .pond-section:not(.is-running) canvas {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pond-frame canvas {
      transition: opacity 600ms var(--ease-precise);
    }
  }

  /* ---------- Hero: full-bleed water with the page title on it ---------- */
  .is-hero {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .is-hero .pond-bar {
    margin-top: 0.75rem;
  }
  .is-hero .pond-frame {
    aspect-ratio: auto;
    /* Edge to edge, and up under the (see-through) header: the water fills the window
       from the very top; the text stays on the site grid. 4.25rem = header height. */
    /* Water + the controls bar below it fit in one screen (the bar is ~5.5rem). */
    height: clamp(32rem, 100svh - 5.5rem, 60rem);
    margin-top: -4.25rem;
    border-radius: 0;
  }
  .pond-overlay {
    position: absolute;
    inset: auto 0 0;
    /* Lifted off the bottom edge so the text sits in the water, clear of the controls. */
    padding-block: clamp(6rem, 18vh, 12rem) clamp(3rem, 9vh, 6rem);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-pond-deep) 92%, transparent) 0%,
      color-mix(in srgb, var(--color-pond-deep) 70%, transparent) 45%,
      transparent 100%
    );
    color: var(--color-foam);
    pointer-events: none;
  }
  .pond-overlay :global(a),
  .pond-overlay :global(button) {
    pointer-events: auto;
  }

  .pond-fallback {
    margin: 1rem 0 0;
    color: var(--color-ink-muted);
  }
  :global(.pond-room) .pond-fallback {
    color: var(--color-foam-soft);
  }

  .koi-card {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    width: min(18rem, calc(100% - 2rem));
    padding: 1rem 1.1rem;
    border-radius: var(--radius-lg);
    background: var(--color-foam);
    color: var(--color-pond-deep);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.6);
  }
  .koi-card p {
    margin: 0;
  }
  .koi-card-name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .koi-card-var {
    font-weight: 600;
    color: #3d5a52;
  }
  .koi-card-note {
    margin-top: 0.5rem !important;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .koi-card-facts {
    margin-top: 0.6rem !important;
    color: #3d5a52;
  }
  .koi-card-x {
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    color: #3d5a52;
    cursor: pointer;
  }
  .koi-card-x:focus-visible {
    outline-color: var(--color-pond-deep);
  }

  .pond-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }
  .pond-hint {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    color: var(--color-ink-muted);
  }
  :global(.pond-room) .pond-hint {
    color: var(--color-foam-soft);
  }
  .pond-live-dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-koi);
    transform: translateY(-0.05em);
  }
  .pond-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .pond-feed {
    min-height: 2.75rem;
  }
  .pond-feed[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  :global(.pond-room) .pond-feed[aria-pressed='true'] {
    background: var(--color-foam);
    color: var(--color-pond-deep);
  }
  .pond-time {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-pill);
  }
  :global(.pond-room) .pond-time {
    border-color: var(--color-foam-soft);
  }
  .pond-time button {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: inherit;
    cursor: pointer;
  }
  .pond-time button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  :global(.pond-room) .pond-time button[aria-pressed='true'] {
    background: var(--color-foam);
    color: var(--color-pond-deep);
  }
  @media (width < 40rem) {
    .pond-frame {
      aspect-ratio: 4 / 5;
    }
    .is-hero .pond-frame {
      height: clamp(34rem, 100svh - 8rem, 46rem);
    }
    .pond-time button {
      padding: 0 0.65rem;
    }
  }
</style>
