---
import BaseLayout from '../layouts/BaseLayout.astro';
import TextLink from '../components/ui/TextLink.astro';

const links = [
  { href: '/', label: 'Homepage' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Start a project' },
];
---

<BaseLayout title="Page not found" description="This page does not exist on ismailapps.com." noindex>
  <section class="nf has-board" aria-labelledby="nf-title">
    <div class="drafting-board" aria-hidden="true"></div>
    <div class="container-site">
      <p class="t-mono nf-tag">404 · not found</p>
      <h1 id="nf-title" class="nf-title">This page never <span class="draft-word" data-text="shipped.">shipped.</span></h1>
      <p class="t-lead nf-lead">The link may be old, or the address mistyped. One of these should get you there:</p>
      <ul class="nf-links">
        {links.map((l) => <li><TextLink href={l.href}>{l.label}</TextLink></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 9rem) var(--section-space);
  }
  .nf-tag {
    display: inline-block;
    margin: 0;
    padding: 0.35rem 0.8rem;
    border: 1px dashed var(--color-ink-muted);
    border-radius: var(--radius-pill);
    color: var(--color-ink-muted);
  }
  .nf-title {
    margin: 1.5rem 0 0;
    max-width: 12ch;
    font-size: clamp(3rem, 1.6rem + 6.4vw, 8rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .nf-lead {
    margin: 1.75rem 0 0;
    max-width: 40ch;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
</style>
