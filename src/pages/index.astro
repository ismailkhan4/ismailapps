---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import StageRows from '../components/home/StageRows.astro';
import BuildProcess from '../components/home/BuildProcess.astro';
import ShippedReel from '../components/home/ShippedReel.astro';
import OwnProductStage from '../components/home/OwnProductStage.astro';
import StudioCrew from '../components/home/StudioCrew.astro';
import GoLive from '../components/home/GoLive.astro';
import FAQSection from '../components/sections/FAQSection.astro';

const faqs = [
  {
    q: 'How much does a project cost?',
    a: 'Every build gets a fixed quote after the scoping sprint, so you know the price before work starts. The sprint itself has a fixed price too. The project form asks for a rough budget range so we can tell you early whether we are a good fit.',
  },
  {
    q: 'Can you take over a product built with AI tools, no-code or a freelancer?',
    a: 'Yes, it is one of our core services. We start by reviewing what exists, then tell you plainly what can stay, what needs hardening and what should be rebuilt. Not every prototype is worth saving, and we will say so when one is not.',
  },
  {
    q: 'Can you work on an existing SaaS product?',
    a: 'Yes. Product engineering & maintenance is a monthly arrangement for teams that need features, AI work, integrations or upkeep on a live product.',
  },
  {
    q: 'Who owns the code and the accounts?',
    a: 'You do, from day one. The repository, hosting and third-party accounts are yours, and we work inside them.',
  },
  {
    q: 'Where are you based?',
    a: 'IsmailApps is run from Pakistan and works with clients in Europe and the United States.',
  },
  {
    q: 'What happens after launch?',
    a: 'Either we keep going on a monthly engineering arrangement, or we hand over cleanly to your team, with the code and accounts already in your name.',
  },
  {
    q: 'Do you build websites?',
    a: 'Yes, conversion-focused websites for software and service businesses. It is a smaller part of what we do; most of our work is SaaS and AI products.',
  },
  {
    q: 'How do we start?',
    a: 'Tell us where your product is today through the project form. We reply by email and suggest a call; if it is a fit, the usual next step is a scoping sprint.',
  },
];
---

<BaseLayout
  title="SaaS and AI product studio"
  description="IsmailApps designs, builds and maintains SaaS and AI products for founders, from a first scope or an AI-built prototype to production, and runs its own."
>
  <!-- The page ships as you scroll: draft on paper → built in ink → live in green. -->
  <HomeHero />
  <StageRows />
  <BuildProcess joined />
  <ShippedReel />
  <OwnProductStage />
  <StudioCrew />
  <FAQSection items={faqs} wide />
  <GoLive />
</BaseLayout>

