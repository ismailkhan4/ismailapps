---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SelectedWork from '../../components/sections/SelectedWork.astro';
import OwnProduct from '../../components/sections/OwnProduct.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { getWork } from '../../lib/content';

const short = await getWork('short');
---

<BaseLayout
  title="Work"
  description="Software IsmailApps has worked on: front ends and integrations for two US SaaS products, websites for businesses in Italy and Palestine, and Hamstalk, our own product."
>
  <PageHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Work' }]}
    title="Software we've shipped"
    lead="Front ends and integrations for two SaaS products in the United States, websites for businesses in Italy and Palestine, and a product of our own that we run every day."
    cta={{ href: '/contact', location: 'work-hero' }}
    secondary={{ href: '#websites', label: 'Websites' }}
  />

  <SelectedWork label="01 · case studies" title="SaaS products we've helped ship" showAll={false} />

  <section class="section" id="websites" aria-labelledby="websites-title">
    <div class="container-site">
      <SectionHeading id="websites-title" label="02 · websites" title="Websites for businesses" />
      <ul class="short-list">
        {
          short.map((w, i) => (
            <li class="short" id={w.id} data-reveal style={`--d:${i}`}>
              <a href={w.data.url} rel="noopener" class="short-link">
                <span class="short-shot">
                  {w.data.cover && (
                    <Image src={w.data.cover} alt={`The ${w.data.title} website`} width={900} loading="lazy" />
                  )}
                </span>
                <span class="short-body">
                  <span class="t-mono short-meta">
                    {w.data.category} · {w.data.clientLocation}
                  </span>
                  <span class="short-title">{w.data.title}</span>
                  <span class="short-summary">{w.data.summary}</span>
                  <span class="short-visit">
                    Visit {new URL(w.data.url).hostname} <span aria-hidden="true">↗</span>
                    <span class="sr-only">(external site)</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <OwnProduct label="03 · our own product" />
  <CTASection location="work-final" />
</BaseLayout>

<style>
  .short-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .short[data-reveal] {
      transition-delay: calc(var(--d) * 100ms);
    }
  }
  .short-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 500ms cubic-bezier(0.2, 0.7, 0, 1),
      border-color 300ms,
      box-shadow 500ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .short-link:hover,
  .short-link:focus-visible {
    transform: translateY(-6px);
    border-color: var(--color-ink);
    box-shadow: 0 24px 50px -30px rgb(23 21 15 / 0.45);
  }
  .short-shot {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-rule);
  }
  .short-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0, 1);
  }
  .short-link:hover .short-shot :global(img) {
    transform: scale(1.04);
  }
  .short-body {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
  }
  .short-meta {
    color: var(--color-ink-muted);
  }
  .short-title {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .short-summary {
    color: var(--color-ink-muted);
  }
  .short-visit {
    margin-top: 0.5rem;
    font-weight: 600;
  }
  @media (width >= 40rem) {
    .short-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
