---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import OwnProductStage from '../../components/home/OwnProductStage.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CTASection from '../../components/sections/CTASection.astro';

const reasons = [
  {
    title: 'We live with the consequences',
    detail: 'When something breaks in our own product, we are the ones who fix it. That changes how carefully we build for clients.',
  },
  {
    title: 'We make the hard cuts',
    detail: 'Deciding what not to build is easier to judge when it is our own time and money. We bring that discipline to your scope.',
  },
  {
    title: 'We run what we ship',
    detail: 'Hosting, updates and support are part of the job, not an afterthought once the build is done.',
  },
];
---

<BaseLayout
  title="Products"
  description="IsmailApps builds and runs its own software products. Hamstalk, five-minute German lessons for software engineers, is the first."
>
  <PageHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Products' }]}
    title="Software we build and run ourselves"
    lead="Most of our work is for clients. Alongside it, we design, build, launch and operate products of our own, and bring what we learn back to every client project."
    cta={{ href: '/products/hamstalk', label: 'Meet Hamstalk', location: 'products-hero' }}
    secondary={{ href: '/contact', label: 'Start a project' }}
  />

  <OwnProductStage standalone />

  <section class="section" aria-labelledby="why-title">
    <div class="container-site">
      <SectionHeading id="why-title" title="Why a client studio builds its own products" />
      <ol class="ruled">
        {
          reasons.map((r, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="ruled-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ruled-title">{r.title}</h3>
              <p class="ruled-detail">{r.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTASection location="products-final" />
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ruled > li[data-reveal] {
      transition-delay: calc(var(--d) * 90ms);
    }
  }
</style>
