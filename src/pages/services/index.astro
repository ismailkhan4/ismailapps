---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import StageRows from '../../components/home/StageRows.astro';
import BuildProcess from '../../components/home/BuildProcess.astro';
import CTASection from '../../components/sections/CTASection.astro';
---

<BaseLayout
  title="Services"
  description="Scoping sprints, SaaS and AI product development, prototype to production, ongoing product engineering, and websites for software businesses."
>
  <PageHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'Services' }]}
    title="What we build"
    lead="We take SaaS and AI products from an idea, or from whatever you have already built, to software that holds up with real users. Start with a scoping sprint, or tell us where you are."
    cta={{ href: '/contact', location: 'services-hero' }}
    secondary={{ href: '#how', label: 'How we work' }}
  />

  <StageRows allLink={false} />

  <BuildProcess id="how" />
  <CTASection location="services-overview" />
</BaseLayout>
