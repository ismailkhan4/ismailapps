---
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import FactSheet from '../../components/ui/FactSheet.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BuildProcess from '../../components/home/BuildProcess.astro';
import WorkIndex from '../../components/sections/WorkIndex.astro';
import FAQSection from '../../components/sections/FAQSection.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { contactHref, getServices } from '../../lib/content';
import { provider } from '../../lib/seo';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const d = service.data;
const { Content } = await render(service);
const related = (await getEntries(d.relatedWork)).filter((w) => !w.data.draft);
const others = (await getServices()).filter((s) => s.id !== service.id);
const contact = contactHref(service);
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.oneLiner,
  url: new URL(`/services/${service.id}`, site.url).href,
  provider,
};
---

<BaseLayout title={d.seo.title} description={d.seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <!-- 1. Problem and promise -->
  <PageHero
    crumbs={[{ href: '/', label: 'Home' }, { href: '/services', label: 'Services' }, { label: d.title }]}
    tag={d.tag}
    title={d.headline}
    lead={d.problem}
    cta={{ href: contact, location: `service-hero:${service.id}` }}
    secondary={{ href: '#how', label: 'How it works' }}
  >
    <FactSheet slot="aside" label="service notes" rows={d.facts} />
  </PageHero>

  <section class="promise" aria-label="Our approach">
    <div class="container-site grid-site">
      <div class="prose" data-reveal>
        <Content />
      </div>
    </div>
  </section>

  <!-- 2. Who it's for -->
  <section class="section" aria-labelledby="for-title">
    <div class="container-site grid-site split">
      <div class="split-head"><SectionHeading id="for-title" title="Who it's for" /></div>
      <ul class="for-list split-body">
        {
          d.forWho.map((line, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="for-arrow" aria-hidden="true">
                →
              </span>
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. What you get -->
  <section class="section" aria-labelledby="get-title">
    <div class="container-site">
      <SectionHeading id="get-title" title="What you get" />
      <ol class="ruled">
        {
          d.deliverables.map((item, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="ruled-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ruled-title">{item.title}</h3>
              <p class="ruled-detail">{item.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. How it works -->
  <BuildProcess id="how" title="How it works" sub={d.oneLiner} steps={d.steps} />

  <!-- 5. Related work -->
  {related.length > 0 && <WorkIndex label="work we've shipped" work={related} products={false} />}

  <!-- 6. FAQ -->
  <FAQSection items={d.faqs} title="Questions" />

  <!-- Other services -->
  <nav class="others" aria-labelledby="others-title">
    <div class="container-site">
      <h2 id="others-title" class="t-label others-title">other services</h2>
      <ul>
        {
          others.map((s) => (
            <li>
              <a href={`/services/${s.id}`} class="other-pill">
                {s.data.title} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- 7. CTA -->
  <CTASection href={contact} location={`service-final:${service.id}`} />
</BaseLayout>

<style>
  .promise {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-rule);
  }
  .prose {
    grid-column: 1 / -1;
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .prose :global(p) {
    margin: 0;
    max-width: 30ch;
  }

  .split {
    row-gap: 2rem;
  }
  .split-head,
  .split-body {
    grid-column: 1 / -1;
  }
  .for-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .for-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .for-arrow {
    color: var(--color-signal-ink);
  }

  /* Staggered reveal for lists and cards. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal][style*='--d'] {
      transition-delay: calc(var(--d) * 80ms);
    }
  }

  .others {
    border-top: 1px solid var(--color-rule);
    padding-block: 2.5rem;
  }
  .others-title {
    margin: 0 0 1rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .other-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 250ms,
      color 250ms,
      border-color 250ms;
  }
  .other-pill:hover,
  .other-pill:focus-visible {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  @media (width >= 56.25rem) {
    .prose {
      grid-column: 3 / span 9;
    }
    .split-head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .split-body {
      grid-column: 5 / span 8;
    }
  }
</style>
