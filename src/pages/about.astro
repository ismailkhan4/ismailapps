---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TextLink from '../components/ui/TextLink.astro';
import Tag from '../components/ui/Tag.astro';
import CTASection from '../components/sections/CTASection.astro';

const team = [
  { role: 'Design', detail: 'Product and interface design' },
  { role: 'Backend', detail: 'APIs, data and business logic' },
  { role: 'Mobile', detail: 'iOS and Android apps' },
  { role: 'QA', detail: 'Testing before anything ships' },
  { role: 'DevOps', detail: 'Cloud, deployment and monitoring' },
  { role: 'AI engineering', detail: 'Models, prompts and integrations' },
];
const principles = [
  { title: 'You own everything', detail: 'The repository, hosting and every third-party account are yours from day one.' },
  { title: 'Scope first, then a fixed price', detail: 'We agree what gets built before quoting, so the price describes real work.' },
  { title: 'See it early', detail: 'You get a staging link early in the build and can click through real progress.' },
  { title: 'Keep what holds', detail: 'Starting from a prototype, we keep what works and fix what will break, rather than rewriting by default.' },
];
---

<BaseLayout
  title="About"
  description="IsmailApps is a small software product studio led by Ismail, with more than five years of building software for clients, and a dedicated team of specialists for the projects that need them."
>
  <PageHero
    crumbs={[{ href: '/', label: 'Home' }, { label: 'About' }]}
    title="A small studio, on purpose."
    lead="IsmailApps is a software product studio. We design, build and maintain SaaS and AI products for founders, and we run our own."
    cta={{ href: '/contact', location: 'about-hero' }}
    secondary={{ href: '/work', label: 'See our work' }}
  />

  <!-- Founder -->
  <section class="section founder" aria-labelledby="founder-title">
    <div class="container-site grid-site">
      <div class="founder-head">
        <p class="t-label">founder and lead</p>
        <h2 id="founder-title" class="founder-name">Ismail</h2>
        <p class="founder-tags">
          <Tag>5+ years building for clients</Tag>
          <Tag tone="signal">prototype to production</Tag>
        </p>
      </div>
      <div class="founder-body" data-reveal>
        <p class="founder-lead">
          Ismail has spent more than five years building software for clients: real products, with real users, data and
          payments.
        </p>
        <p>
          He scopes every project himself, does much of the building, and stays accountable from the first call to
          maintenance. On Supervise and Whatever AI, two SaaS products for clients in the United States, he built the
          front end and the integrations.
        </p>
        <p>
          More and more of that work now starts from a prototype someone built quickly with AI tools or no-code. The job
          is to turn it into software that holds up: keep what works, fix what will break, and take it to production.
        </p>
      </div>
    </div>
  </section>

  <!-- How the studio works -->
  <section class="section" aria-labelledby="model-title">
    <div class="container-site">
      <SectionHeading id="model-title" title="One accountable lead, a dedicated team" />
      <div class="model">
        <div class="model-text" data-reveal>
          <h3 class="model-title"><span class="t-mono model-n">01</span>One person accountable</h3>
          <p>
            You work directly with Ismail from scoping to launch and beyond. No account managers, no hand-offs between
            people who have never met your product.
          </p>
        </div>
        <div class="model-text" data-reveal style="--d:1">
          <h3 class="model-title"><span class="t-mono model-n">02</span>A dedicated team behind the work</h3>
          <p>
            Projects that need more than one pair of hands get our dedicated team. Each specialist joins for the part of the
            build that needs them, and you still have one point of contact.
          </p>
        </div>
      </div>

      <!-- The team assembles: each discipline fills in from outline to ink (kinetic.ts adds .is-in). -->
      <div class="crew" data-crew>
        <p class="t-mono crew-label">joins when the project needs it</p>
        <ul class="crew-list">
          {
            team.map((t, i) => (
              <li style={`--i:${i}`}>
                <span class="crew-word" data-text={t.role}>
                  {t.role}
                </span>
                <span class="crew-detail">{t.detail}</span>
              </li>
            ))
          }
        </ul>
        <p class="crew-example">
          On Vectum, an Italian logistics company's website, our DevOps team deployed the site to AWS.
        </p>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section" aria-labelledby="principles-title">
    <div class="container-site grid-site split">
      <div class="split-head">
        <SectionHeading id="principles-title" title="How we work with you" />
      </div>
      <ol class="ruled ruled-compact split-body">
        {
          principles.map((p, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="ruled-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ruled-title">{p.title}</h3>
              <p class="ruled-detail">{p.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Vision -->
  <section class="vision panel-ink" aria-labelledby="vision-title" data-theme="ink">
    <div class="container-site grid-site">
      <div class="vision-head">
        <p class="t-label">where we are going</p>
        <h2 id="vision-title" class="vision-title">A product company that still builds for others.</h2>
      </div>
      <div class="vision-body">
        <p>
          Client work is the core of the studio today. Alongside it we build and run our own products, starting with
          Hamstalk. Over the next few years we want more of them, without ever stopping the work we do for founders.
        </p>
        <p class="vision-where">We work from Pakistan with clients in Europe and the United States.</p>
        <div class="vision-links">
          <TextLink href="/products">Our products</TextLink>
          <TextLink href="/services">What we build for clients</TextLink>
        </div>
      </div>
    </div>
  </section>

  <CTASection location="about-final" />
</BaseLayout>

<style>
  .founder {
    border-top: 1px solid var(--color-rule);
  }
  .founder :global(.grid-site) {
    row-gap: 2rem;
  }
  .founder-head,
  .founder-body {
    grid-column: 1 / -1;
  }
  .founder-name {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(3.5rem, 2rem + 7vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .founder-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .founder-body p {
    margin: 0 0 1.25rem;
    max-width: 52ch;
    color: var(--color-ink-muted);
    font-size: var(--step-0);
  }
  .founder-body .founder-lead {
    color: var(--color-ink);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* ---------- The model: two commitments, then the team assembling ---------- */
  .model {
    display: grid;
    gap: 2rem 3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .model-title {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin: 0 0 0.75rem;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .model-n {
    color: var(--color-ink-muted);
    font-weight: 400;
  }
  .model-text p {
    margin: 0;
    max-width: 48ch;
    color: var(--color-ink-muted);
  }

  /* Same crew rows as the homepage's studio section (StudioCrew). */
  .crew {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .crew-label {
    margin: 0 0 1rem;
    color: var(--color-ink-muted);
  }
  .crew-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .crew-list li {
    display: grid;
    gap: 0.25rem 2rem;
    align-items: center;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .crew-word {
    position: relative;
    display: inline-block;
    justify-self: start;
    padding-block: 0.12em;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: max(1px, 0.012em) var(--color-ink-muted);
  }
  .crew-word::after {
    content: attr(data-text);
    content: attr(data-text) / '';
    position: absolute;
    inset: 0;
    padding-block: inherit;
    color: var(--color-ink);
    -webkit-text-stroke: 0;
    clip-path: inset(-0.2em 0 -0.2em 0);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .crew-word::after {
      clip-path: inset(-0.2em 100% -0.2em 0);
      transition: clip-path 900ms cubic-bezier(0.65, 0, 0.35, 1);
      transition-delay: calc(var(--i) * 140ms);
    }
    :global(.js) .crew:global(.is-in) .crew-word::after {
      clip-path: inset(-0.2em 0 -0.2em 0);
    }
  }
  .crew-detail {
    padding-bottom: 0.6rem;
    color: var(--color-ink-muted);
  }
  .crew-example {
    margin: 1.25rem 0 0;
    max-width: 60ch;
    color: var(--color-ink-muted);
  }

  .split {
    row-gap: 2rem;
  }
  .split-head,
  .split-body {
    grid-column: 1 / -1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal][style*='--d'] {
      transition-delay: calc(var(--d) * 80ms);
    }
  }

  .vision {
    padding-block: var(--section-space);
  }
  .vision :global(.grid-site) {
    row-gap: 2rem;
  }
  .vision-head,
  .vision-body {
    grid-column: 1 / -1;
  }
  .vision-title {
    margin: 0.6rem 0 0;
    max-width: 16ch;
    font-size: var(--step-4);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .vision-body p {
    margin: 0 0 1.25rem;
    max-width: 48ch;
    color: var(--color-ink-soft);
  }
  .vision-body p:first-child {
    color: var(--color-paper);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .vision-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }

  @media (width >= 56.25rem) {
    .model {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .crew-list li {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
    }
    .crew-detail {
      padding-bottom: 0;
    }
    .founder-head {
      grid-column: 1 / span 5;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .founder-body {
      grid-column: 7 / span 6;
    }
    
    .split-head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .split-body {
      grid-column: 5 / span 8;
    }
    .vision-head {
      grid-column: 1 / span 6;
    }
    .vision-body {
      grid-column: 8 / span 5;
      align-self: end;
    }
  }
</style>
