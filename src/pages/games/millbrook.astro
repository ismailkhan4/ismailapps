---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import LivePond from '../../components/games/millbrook/LivePond.astro';
import StreamPuzzle from '../../components/games/millbrook/StreamPuzzle.astro';
import Dredge from '../../components/games/millbrook/Dredge.astro';
import KoiGrid from '../../components/games/millbrook/KoiGrid.astro';
import GameWaitlist from '../../components/games/GameWaitlist.astro';
import { exists, planned } from '../../games/millbrook/content';
import { games } from '../../lib/games';
import { provider } from '../../lib/seo';

const game = games.find((g) => g.slug === 'millbrook')!;
const steps = [
  { title: 'Turn the stream', detail: 'Rotate channel tiles until the spring water reaches every one. Food on a tile only counts if the water gets to it.' },
  { title: 'Feed the koi who ask', detail: 'Koi swim up with orders. Fill them with the food you gathered and earn coins and experience.' },
  { title: 'Dig out the pond', detail: 'Spend coins to dredge the next stretch of the old mill pond. It brings new koi, new food and room to decorate.' },
];
const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.name,
  description: game.summary,
  genre: ['Puzzle', 'Casual'],
  gamePlatform: game.platforms,
  publisher: provider,
};
---

<BaseLayout title="Millbrook, a koi pond puzzle game" description={`${game.name}: ${game.summary} In development at IsmailApps.`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(gameLd)} />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <PageHero
    crumbs={[{ href: '/', label: 'Home' }, { href: '/games', label: 'Games' }, { label: game.name }]}
    kicker="An IsmailApps game"
    tag="In development"
    title={game.name}
    lead={`${game.tagline}. ${game.summary}`}
    cta={{ href: '#waitlist', label: 'Join the waitlist', location: 'game-hero:millbrook' }}
    secondary={{ href: '#play', label: 'Try the puzzle' }}
  />

  <LivePond />

  <section class="section" aria-labelledby="loop-title">
    <div class="container-site">
      <h2 id="loop-title" class="t-h2 loop-title">How it plays</h2>
      <ol class="ruled">
        {
          steps.map((s, i) => (
            <li>
              <span class="ruled-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ruled-title">{s.title}</h3>
              <p class="ruled-detail">{s.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <StreamPuzzle />
  <Dredge />
  <KoiGrid />

  <section class="section" aria-labelledby="status-title">
    <div class="container-site">
      <h2 id="status-title" class="t-h2">Where the game is</h2>
      <p class="t-lead status-lead">No lives, no energy bars, no timers and no loot boxes. Skip a week and the pond is just as you left it.</p>
      <div class="status-cols">
        <div>
          <h3 class="status-head">Working today</h3>
          <ul class="status-list">{exists.map((p) => <li><strong>{p.title}</strong><span>{p.text}</span></li>)}</ul>
        </div>
        <div>
          <h3 class="status-head">Coming next</h3>
          <ul class="status-list">{planned.map((p) => <li><strong>{p.title}</strong><span>{p.text}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <GameWaitlist game={game.slug} name={game.name} />
</BaseLayout>

<style>
  .loop-title {
    margin: 0;
  }
  .status-cols h3,
  .status-lead {
    margin: 0;
  }
  .status-lead {
    margin-top: 1rem;
    max-width: 48ch;
  }
  .status-cols {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .status-head {
    font-size: var(--step-1);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-ink);
  }
  .status-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .status-list li {
    display: grid;
    gap: 0.2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .status-list span {
    color: var(--color-ink-muted);
  }
  @media (width >= 56.25rem) {
    .status-cols {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
